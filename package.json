{
  "name": "figma-agent",
  "displayName": "Figma Agent",
  "description": "Process Figma comments and generate development tasks automatically",
  "version": "1.0.0",
  "publisher": "figma-agent",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Productivity",
    "Visualization"
  ],
  "keywords": [
    "figma",
    "design",
    "comments",
    "automation",
    "ai",
    "openai",
    "productivity",
    "workflow"
  ],
  "activationEvents": [
    "onView:figmaAgentSidebar"
  ],
  "main": "./dist/extension/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "package": "vsce package"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "typescript": "^5.2.2",
    "vsce": "^2.15.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@jest/globals": "^29.5.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "figmaAgent.fetchComments",
        "title": "Fetch Figma Comments"
      },
      {
        "command": "figmaAgent.generatePrompts",
        "title": "Generate Development Prompts"
      },
      {
        "command": "figmaAgent.exportFile",
        "title": "Export Prompts"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "figmaAgentSidebar",
          "title": "Figma Agent",
          "icon": "resources/figma-icon.svg"
        }
      ]
    },
    "views": {
      "figmaAgentSidebar": [
        {
          "id": "figmaComments",
          "name": "Comments"
        },
        {
          "id": "figmaPrompts",
          "name": "Prompts"
        }
      ]
    },
    "configuration": {
      "title": "Figma Agent",
      "properties": {
        "figmaAgent.apiToken": {
          "type": "string",
          "description": "Figma API Token"
        },
        "figmaAgent.openaiApiKey": {
          "type": "string",
          "description": "OpenAI API Key for generating prompts"
        },
        "figmaAgent.openaiModel": {
          "type": "string",
          "enum": [
            "gpt-4",
            "gpt-4-turbo-preview",
            "gpt-3.5-turbo"
          ],
          "default": "gpt-4",
          "description": "OpenAI model to use for generating prompts"
        },
        "figmaAgent.exportFormat": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "txt"
          ],
          "default": "json",
          "description": "Default export format for prompts"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uilfl/figma-comment-agent.git"
  },
  "bugs": {
    "url": "https://github.com/uilfl/figma-comment-agent/issues"
  },
  "homepage": "https://github.com/uilfl/figma-comment-agent#readme",
  "license": "MIT"
}
